{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/preload/index.ts",
    "src/main/database/repositories/albumRepo.ts",
    "src/main/database/repositories/artistRepo.ts",
    "src/main/database/repositories/folderRepo.ts",
    "src/main/database/repositories/playlistRepo.ts",
    "src/main/database/repositories/rowMapper.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
